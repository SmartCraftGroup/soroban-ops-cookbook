# Generated by anchor-configs. Shape from the Anchor Platform quick-run
# config/assets.yaml. See:
# https://developers.stellar.org/docs/platforms/anchor-platform/admin-guide/assets-and-client-wallets
items:
  - id: stellar:{{ASSET_CODE}}:{{ASSET_ISSUER}}
    # The Stellar account that holds the asset for deposits/withdrawals.
    # Replace with a real account before accepting deposits.
    distribution_account: "{{DISTRIBUTION_ACCOUNT}}"
    significant_decimals: {{SIGNIFICANT_DECIMALS}}
    sep24:
      enabled: {{SEP24_ENABLED}}
    sep31:
      enabled: {{SEP31_ENABLED}}
    sep38:
      enabled: {{SEP38_ENABLED}}
      exchangeable_assets:
        - iso4217:USD
