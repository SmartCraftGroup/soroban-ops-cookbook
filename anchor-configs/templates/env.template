# Generated by anchor-configs. Based on the Anchor Platform quick-run
# (dev.env) — verify against
# https://developers.stellar.org/docs/platforms/anchor-platform if upgrading.

# --- Stellar network ---------------------------------------------------------
STELLAR_NETWORK_TYPE=rpc
STELLAR_NETWORK_RPC_URL={{RPC_URL}}

# --- SEP-1: stellar.toml -----------------------------------------------------
SEP1_ENABLED=true
SEP1_TOML_TYPE=file
SEP1_TOML_VALUE=/config/stellar.toml

# --- SEP-10: Web auth --------------------------------------------------------
SEP10_ENABLED={{SEP10_ENABLED}}
SEP10_WEB_AUTH_DOMAIN={{HOME_DOMAIN}}
SEP10_HOME_DOMAINS={{HOME_DOMAIN}}
SECRET_SEP10_SIGNING_SEED={{SEP10_SIGNING_SEED}}
SECRET_SEP10_JWT_SECRET={{SEP10_JWT_SECRET}}

# --- SEP-12: KYC -------------------------------------------------------------
SEP12_ENABLED={{SEP12_ENABLED}}

# --- SEP-24: Hosted deposits/withdrawals --------------------------------------
SEP24_ENABLED={{SEP24_ENABLED}}
# Points at the bundled reference UI for local demos. Point these at YOUR
# backend's interactive/more-info endpoints in production.
SEP24_INTERACTIVE_URL_BASE_URL=http://localhost:3000
SEP24_MORE_INFO_URL_BASE_URL=http://localhost:3000

# --- SEP-31: Cross-border payments -------------------------------------------
SEP31_ENABLED={{SEP31_ENABLED}}

# --- SEP-38: Quotes -----------------------------------------------------------
SEP38_ENABLED={{SEP38_ENABLED}}

# --- Assets ------------------------------------------------------------------
ASSETS_TYPE=file
ASSETS_VALUE=/config/assets.yaml

# --- Database (Postgres) ------------------------------------------------------
DATA_TYPE=postgres
DATA_SERVER=db:5432
DATA_DATABASE=anchor_platform
DATA_SCHEMA=anchor-platform
DATA_FLYWAY_ENABLED=true
SECRET_DATA_USERNAME=anchor
SECRET_DATA_PASSWORD={{DB_PASSWORD}}

# --- Platform API (used by your backend to query tx status) -------------------
PLATFORM_API_BASE_URL=http://anchor-platform:8085

# --- Logging ------------------------------------------------------------------
APP_LOGGING_STELLAR_LEVEL=INFO
