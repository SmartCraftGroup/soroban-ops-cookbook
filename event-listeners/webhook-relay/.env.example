# Soroban RPC endpoint (testnet default)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Contract to watch
CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Where to POST each event
WEBHOOK_URL=https://your-service.example.com/events

# Optional: seconds between poll ticks (default 10)
POLL_INTERVAL_SECS=10

# Required — Soroban RPC rejects ledgers older than its retention window.
# Get a recent one with: curl -X POST $SOROBAN_RPC_URL \
#   -H 'Content-Type: application/json' \
#   -d '{"jsonrpc":"2.0","id":1,"method":"getLatestLedger"}'
START_LEDGER=

# Optional: comma-separated substrings matched against event topic values
# TOPIC_FILTER=transfer,swap

# Optional: max delivery retries per event (default 5)
MAX_RETRIES=5
