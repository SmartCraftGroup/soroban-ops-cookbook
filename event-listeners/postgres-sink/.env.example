# Soroban RPC endpoint (testnet default)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Contract to watch
CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Postgres connection string (matches docker-compose.yml in this folder)
DATABASE_URL=postgres://sink:sink@localhost:5433/soroban_events

# Optional: seconds between poll ticks (default 10)
POLL_INTERVAL_SECS=10

# Required on first run (no persisted cursor yet). Must be a recent ledger —
# get one with: curl -X POST $SOROBAN_RPC_URL -H 'Content-Type: application/json' \
#   -d '{"jsonrpc":"2.0","id":1,"method":"getLatestLedger"}'
START_LEDGER=

# Optional: comma-separated substrings matched against event topic values
# TOPIC_FILTER=transfer,swap

# Optional: max RPC fetch retries with backoff before sleeping (default 3)
MAX_RETRIES=3
